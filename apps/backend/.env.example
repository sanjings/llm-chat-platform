# 数据库（本机建议 host 用 127.0.0.1，避免 localhost/IPv6 差异）
DATABASE_URL="mysql://root:password@127.0.0.1:3306/llm_chat_platform"
# MySQL 8 caching_sha2_password：无 TLS 的 TCP 需向服务器取 RSA 公钥；代码默认 allowPublicKeyRetrieval=true
# 生产若走 TLS 且需关闭：DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# DATABASE_CONNECT_TIMEOUT_MS=15000
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# JWT（生产环境务必更换）
JWT_SECRET="your-super-secret-jwt-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="123456"

# ---------- 大模型 ----------
# LLM_PROVIDER 只决定「请求没带 modelId」时的默认线路。
# dashscope = 通义；openai_compatible / deepseek = DeepSeek（OpenAI 兼容接口）
# 新会话可以同时选通义和 DeepSeek，两边都配了对应密钥就会真正打到各自接口。
LLM_PROVIDER="dashscope"

# 默认线路的密钥。LLM_PROVIDER=dashscope 时当作通义密钥；=openai_compatible / deepseek 时当作 DeepSeek 密钥。
# 不会拿这一把钥匙去调另一家。
LLM_API_KEY=""

# 通义 DashScope。配置后通义模型可选，优先于上面的 LLM_API_KEY。
# DASHSCOPE_API_KEY="your-dashscope-api-key"
# 可选。默认北京旧域名的兼容模式，当前千问模型走这里。
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# DeepSeek。配置后 DeepSeek 模型可选，优先于上面的 LLM_API_KEY。
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# 部署时覆盖可选模型。不配、或只写空白时，仍用代码里的正式目录：
# 通义 qwen3.8-max、qwen3.7-plus、qwen3.8-flash；DeepSeek deepseek-flash、deepseek-v4-pro。
# 两个变量互不影响：只配通义时，DeepSeek 两款保持不变；只配 DeepSeek 时，通义三款保持不变。
# 值为逗号分隔的模型 ID，顺序即 GET /api/chat/models 的返回顺序。可以写正式目录里没有的 ID。同一个 ID 只写在一个变量里。
# LLM_DASHSCOPE_MODELS 里的 ID 走 dashscope（DASHSCOPE_API_KEY；仅当 LLM_PROVIDER 为通义时才回退 LLM_API_KEY）。
# LLM_DEEPSEEK_MODELS 里的 ID 走 openai_compatible（DEEPSEEK_API_KEY；仅当 LLM_PROVIDER 为 DeepSeek 时才回退 LLM_API_KEY）。
# 已有会话继续使用它绑定的模型，即使该模型已经不在当前可选列表里。
# 未命中当前列表、正式目录和旧别名时：qwen* 走 dashscope，deepseek* 走 openai_compatible。
#
# 写法示例（只覆盖通义列表和默认模型，DeepSeek 保持正式目录）。不要把示例名单写进代码默认目录：
# LLM_DASHSCOPE_MODELS="qwen3.8-27b,qwen3.8-flash,qwen3.8-max-0902"
# LLM_MODEL="qwen3.8-flash"

# 未传 modelId 时，在 LLM_PROVIDER 对应线路上使用的模型名。
# 也是 GET /api/chat/models 返回的 defaultModelId，不另设第二个默认模型变量。
# 不配则通义线路用 qwen3.7-plus，DeepSeek 线路用 deepseek-flash。
# 覆盖可选列表后，请把这里设成当前列表里的一个 ID；否则默认名仍是上面的内置值，即使它已不在列表中。
# 请求带了 modelId 时以 modelId 为准：先按当前可选列表选线路，未命中再按正式目录、旧别名，以及 qwen* / deepseek* 前缀；都未命中才用 LLM_PROVIDER。
LLM_MODEL=""

# 仅 DeepSeek / openai_compatible 需要，默认 https://api.deepseek.com/v1
# LLM_BASE_URL="https://api.deepseek.com/v1"

# 分页 pageSize 上限；0 或不配表示不按环境变量截断
# PAGINATION_MAX_PAGE_SIZE="0"

# 回答格式为 markdown 且上下文里还没有 Markdown 说明时追加；不配则用代码内默认文案
# LLM_MARKDOWN_SYSTEM_PROMPT="请使用 Markdown 格式回答。标题、列表、代码块请按标准 Markdown 输出。"
