# 数据库（本机建议 host 用 127.0.0.1，避免 localhost/IPv6 差异）
DATABASE_URL="mysql://root:password@127.0.0.1:3306/llm_chat_platform"
# MySQL 8 caching_sha2_password：无 TLS 的 TCP 需向服务器取 RSA 公钥；代码默认 allowPublicKeyRetrieval=true
# 生产若走 TLS 且需关闭：DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# DATABASE_CONNECT_TIMEOUT_MS=15000
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# JWT（生产环境务必更换）
JWT_SECRET="your-super-secret-jwt-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="123456"

# ---------- 大模型 ----------
# LLM_PROVIDER 只决定「请求没带 modelId」时的默认线路。
# dashscope = 通义；openai_compatible / deepseek = DeepSeek（OpenAI 兼容接口）
# 新会话可以同时选通义和 DeepSeek，两边都配了对应密钥就会真正打到各自接口。
LLM_PROVIDER="dashscope"

# 默认线路的密钥。LLM_PROVIDER=dashscope 时当作通义密钥；=openai_compatible / deepseek 时当作 DeepSeek 密钥。
# 不会拿这一把钥匙去调另一家。
LLM_API_KEY=""

# 通义 DashScope。配置后通义模型可选，优先于上面的 LLM_API_KEY。
# DASHSCOPE_API_KEY="your-dashscope-api-key"
# 可选。默认北京旧域名的兼容模式，当前千问模型走这里。
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# DeepSeek。配置后 DeepSeek 模型可选，优先于上面的 LLM_API_KEY。
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# 未传 modelId 时的模型名；不配则通义用 qwen3.7-plus，DeepSeek 用 deepseek-flash
# 若请求里带 modelId 且命中 chat.services 内映射，则按 modelId 选线路与模型
LLM_MODEL=""

# 仅 DeepSeek / openai_compatible 需要，默认 https://api.deepseek.com/v1
# LLM_BASE_URL="https://api.deepseek.com/v1"

# 分页 pageSize 上限；0 或不配表示不按环境变量截断
# PAGINATION_MAX_PAGE_SIZE="0"

# 回答格式为 markdown 且上下文里还没有 Markdown 说明时追加；不配则用代码内默认文案
# LLM_MARKDOWN_SYSTEM_PROMPT="请使用 Markdown 格式回答。标题、列表、代码块请按标准 Markdown 输出。"
